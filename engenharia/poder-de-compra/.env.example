# Copie para .env e preencha. Nunca versione o .env.
# Databricks Free Edition (veja docs/databricks.md). Vazio = roda só no DuckDB local.
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=
# opcional: vazio = usa o primeiro SQL warehouse da conta
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=poder_compra
