# Copie para .env (chmod 600). NUNCA versione o .env.
# Gere a chave do cofre com:  docker run --rm mercado:latest python -m app gerar-chave
FERNET_KEY=
# Senha do painel (vazio = sem login; só aceitável numa LAN confiável)
PAINEL_SENHA=
# Senha do noVNC (ver/assumir as abas do checkout). Vazio desliga o noVNC.
VNC_SENHA=

# Rede / pastas (lidos pelo docker-compose)
BIND_IP=127.0.0.1
PORTA_HOST=8100
PORTA_VNC=8101
DADOS=./dados
UID_GID=1000:1000

# Coleta noturna
COLETA_HORA=3
COLETA_MINUTO=0
JITTER_MIN=0.8
JITTER_MAX=2.4
LIMIAR_FUZZY=88

# Mercado Livre: a busca pública pede token desde 2025 (app grátis em developers.mercadolivre.com.br)
ML_ACCESS_TOKEN=
# Proxy de saída opcional para a coleta (ex.: http://usuario:senha@host:porta)
HTTP_PROXY_COLETA=
